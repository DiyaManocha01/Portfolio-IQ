# Compose-level configuration for `docker compose up` (docker-compose.yml).
# Copy to .env and adjust. This is separate from backend/.env.example and
# frontend/.env.example, which configure the apps themselves when run
# outside Docker (see each directory's own .env.example / README).
#
# You still need backend/.env to exist (cp backend/.env.example backend/.env)
# -- the backend container reads it via env_file for everything except
# DATABASE_URL, which docker-compose.yml overrides to point at the `db`
# service instead of localhost.

# --- Postgres (used to build both the db container's own credentials
# and the backend's DATABASE_URL -- keep these in sync, which compose
# does automatically since both reference the same variables) ---
POSTGRES_USER=portfolioiq
POSTGRES_PASSWORD=portfolioiq_dev_pw
POSTGRES_DB=portfolioiq

# --- Frontend build arg (baked in at image build time -- see
# frontend/Dockerfile's comment on why this can't be a runtime env var
# for a static build). Must be reachable from the browser using this
# app, not just from inside the Compose network. ---
VITE_API_BASE_URL=http://localhost:8000

# --- Backend CORS allowlist ---
CORS_ORIGINS=http://localhost:5173
