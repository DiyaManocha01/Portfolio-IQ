# PortfolioIQ backend environment configuration
# Copy this file to .env and adjust values for your machine.

# --- Database ---
DATABASE_URL=postgresql+psycopg2://portfolioiq:portfolioiq_dev_pw@localhost:5432/portfolioiq

# --- Auth / JWT ---
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# --- Market data ---
# When false (default), MarketDataService uses the built-in DEV_SAMPLE provider,
# which generates clearly-labeled synthetic OHLCV data locally (no external API
# key required). Set to true only if a live provider is configured/reachable.
USE_LIVE_MARKET_DATA=false
MARKET_DATA_API_KEY=

# --- Real-time market data (Phase 24, Angel One SmartAPI) ---
# When false (default), the app never opens a broker WebSocket connection;
# /market/* endpoints report status UNAVAILABLE instead of erroring. Flip
# to true only once ANGELONE_* below are filled in with YOUR OWN trading
# account's credentials (requires an Angel One account with API access
# enabled -- see https://smartapi.angelbroking.com). NEVER commit real
# values -- this file is the template; your actual credentials go in the
# local, gitignored .env only.
ENABLE_REALTIME_FEED=false
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PASSWORD=
# TOTP secret from Angel One's 2FA setup (the base32 string behind the QR
# code), NOT a 6-digit code -- the app generates fresh codes from this at
# login time. See docs/adr/0008-realtime-market-data-angelone.md.
ANGELONE_TOTP_SECRET=

# --- News / Sentiment ---
# When false (default), SentimentService uses a fast lexicon-based financial
# sentiment provider. Set to true to use the FinBERT transformer pipeline
# (requires internet access to download model weights from Hugging Face on
# first run, and the `transformers` + `torch` packages installed).
USE_FINBERT=false
# When true, NewsService prefers real headlines cached locally by
# `python scripts/fetch_news_rss.py` (Economic Times / Moneycontrol RSS --
# no API key needed) over the synthetic template headlines, falling back to
# synthetic per-stock if no real headline matched that symbol. Run the
# fetch script first; this sandbox cannot reach either RSS host itself.
USE_LIVE_NEWS=false
# Reserved for a future API-key-based news source; unused by the RSS path
# above. Kept on its own line (not a trailing inline comment) because
# Docker Compose's env_file parser, unlike python-dotenv, does not strip
# trailing `#` comments and would otherwise fold the comment text itself
# into the value.
NEWS_API_KEY=

# --- AI Portfolio Assistant (Phase 19) ---
# Required for POST /assistant/ask to work -- without it, the endpoint
# returns a clear 503 ("assistant not configured") rather than failing
# oddly. Get a key at https://console.anthropic.com/. NEVER commit a real
# key here -- this file is the template; your actual key goes in the
# local, gitignored .env only.
ANTHROPIC_API_KEY=
# Pick whatever current Claude model fits your budget/latency needs --
# check https://docs.claude.com/en/docs/about-claude/models for what's
# currently available; this default may age out over time.
ASSISTANT_MODEL=claude-sonnet-5-5

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Production readiness (Phase 34) ---
# Structured JSON log level. INFO logs one line per request (method, path,
# status, duration, correlation ID) plus anything the app itself logs;
# raise to WARNING or ERROR in a high-traffic deployment if that's too
# noisy. See app/services/logging_config.py.
LOG_LEVEL=INFO
# Error tracking (Sentry, https://sentry.io -- a separate account/project
# you create yourself, not run by this app). Empty by default: sentry_sdk
# is simply never initialized, a true no-op, not just "quiet." Set your
# own project's DSN here to get real exception alerting once deployed.
# NEVER commit a real DSN -- this file is the template; your actual value
# goes in the local, gitignored .env only.
SENTRY_DSN=
# Fraction of requests to trace for Sentry's performance monitoring (0.0 =
# off, which is the sane default for a low-traffic demo deployment; raise
# only if you specifically want latency tracing and are comfortable with
# the added Sentry event volume it generates).
SENTRY_TRACES_SAMPLE_RATE=0.0
