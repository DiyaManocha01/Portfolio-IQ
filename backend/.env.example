# PortfolioIQ backend environment configuration
# Copy this file to .env and adjust values for your machine.

# --- Database ---
DATABASE_URL=postgresql+psycopg2://portfolioiq:portfolioiq_dev_pw@localhost:5432/portfolioiq

# --- Auth / JWT ---
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# --- Market data ---
# When false (default), MarketDataService uses the built-in DEV_SAMPLE provider,
# which generates clearly-labeled synthetic OHLCV data locally (no external API
# key required). Set to true only if a live provider is configured/reachable.
USE_LIVE_MARKET_DATA=false
MARKET_DATA_API_KEY=

# --- News / Sentiment ---
# When false (default), SentimentService uses a fast lexicon-based financial
# sentiment provider. Set to true to use the FinBERT transformer pipeline
# (requires internet access to download model weights from Hugging Face on
# first run, and the `transformers` + `torch` packages installed).
USE_FINBERT=false
# When true, NewsService prefers real headlines cached locally by
# `python scripts/fetch_news_rss.py` (Economic Times / Moneycontrol RSS --
# no API key needed) over the synthetic template headlines, falling back to
# synthetic per-stock if no real headline matched that symbol. Run the
# fetch script first; this sandbox cannot reach either RSS host itself.
USE_LIVE_NEWS=false
NEWS_API_KEY=  # reserved for a future API-key-based news source; unused by the RSS path above

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
